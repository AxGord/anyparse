package anyparse.grammar.json;

/**
 * Marker class for the macro-generated query walker of `JValue` — the projection of the span
 * parser's paired AST (`JValueSpanParser`) onto the engine's `QueryNode` tree, generated by the
 * same `Build.buildQueryWalker` codegen as `HaxeQueryWalker`.
 *
 * Every kind is the grammar's own ctor name — `JObject`, `JArray`, `JString`, `JNumber`, `JBool`,
 * `JNull` — plus `Member`, the `@:spanned` object entry; a `JString` is named by its decoded value
 * and a `Member` by its decoded key (`@:queryName`). `JsonProjection` wraps the walk in the
 * document root.
 *
 * The class body is empty on purpose: every member is contributed by the macro.
 */
@:build(anyparse.macro.Build.buildQueryWalker(anyparse.grammar.json.JValue, anyparse.grammar.json.JValueSpanParser))
@:nullSafety(Strict)
class JsonQueryWalker {}
