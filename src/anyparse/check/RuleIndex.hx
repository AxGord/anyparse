package anyparse.check;

import anyparse.check.Check.DefaultOff;
import anyparse.check.Check.LanguageBound;
import anyparse.check.Check.VersionGated;
import haxe.format.JsonPrinter;

using StringTools;

/**
 * The rule index by category as markdown — what `apq lint --list-rules --format markdown` prints and
 * `docs/lint-rules.md` holds, a suite test keeping the two equal so a rule cannot ship without its line.
 */
@:nullSafety(Strict)
final class RuleIndex {

	/** The index of `checks`: a table of the categories that hold any of them, then one section per category, rules by id. */
	public static function markdown(checks: Array<Check>): String {
		final out: StringBuf = new StringBuf();
		out.add('# Lint rules by category\n\n');
		out.add(
			'Generated by `apq lint --list-rules --format markdown` from the rule registry; a suite test fails when the two disagree, so '
			+ 'regenerate this file instead of editing it. '
		);
		out.add(
			'A rule\'s category is what an `apqlint.json` `"categories"` entry and `apq lint --category <id>` select it by ('
			+ '[cli-query-tool.md](cli-query-tool.md) § "`apq lint`"). '
		);
		out.add('Each rule id links to its prose in the [user guide](guide/README.md): what it flags, why, the fix, an example.\n\n');
		out.add('| category | rules | about |\n|---|---:|---|\n');
		final sections: Array<{ category: RuleCategory, rules: Array<Check> }> = [];
		for (category in RuleCategory.ALL) {
			final rules: Array<Check> = checks.filter(c -> c.category() == category);
			if (rules.length == 0) continue;
			rules.sort((a, b) -> Reflect.compare(a.id(), b.id()));
			sections.push({ category: category, rules: rules });
			out.add('| [`$category`](#$category) | ${rules.length} | ${category.description()} |\n');
		}
		for (section in sections) {
			out.add('\n## `${section.category}`\n\n${section.category.description()}.\n\n');
			out.add('| rule | language | default | description |\n|---|---|---|---|\n');
			for (rule in section.rules) {
				final state: String = rule is DefaultOff ? 'off' : 'on';
				final requires: String = rule is VersionGated
					? ' (fix needs language ${(cast rule: VersionGated).minLanguageVersion()})'
					: '';
				out.add('| ${guideLink(rule)} | ${languageOf(rule)} | $state | ${cell(rule.description())}$requires |\n');
			}
		}
		return out.toString();
	}

	/**
	 * The registry as data, one `{id, category, description, languages, defaultOn}` record
	 * per rule (`languages` empty for a rule every grammar runs) in registry order — what
	 * `apq lint --list-rules --format json` prints for a tool that keys rules by category.
	 */
	public static function json(checks: Array<Check>): String {
		final records: Array<{
			id: String,
			category: String,
			description: String,
			languages: Array<String>,
			defaultOn: Bool
		}> = [
			for (c in checks)
				{
					id: c.id(),
					category: c.category(),
					description: c.description(),
					languages: c is LanguageBound ? (cast c: LanguageBound).languages() : [],
					defaultOn: !(c is DefaultOff)
				}
		];
		return JsonPrinter.print(records, null, '  ') + '\n';
	}

	/** The grammars `check` runs on as a listing spells them: its `LanguageBound` languages, or `any` for a check every grammar runs. */
	public static function languageOf(check: Check): String {
		return check is LanguageBound ? (cast check: LanguageBound).languages().join(', ') : 'any';
	}

	/**
	 * `check`'s id as a link to its prose section, `guide/lint/<category>.md#<id>`
	 * — a heading's anchor is its text without the backticks.
	 */
	public static function guideLink(check: Check): String {
		return '[`${check.id()}`](guide/lint/${check.category()}.md#${check.id()})';
	}

	/** `text` safe inside a markdown table cell: a pipe would end the cell. */
	private static inline function cell(text: String): String {
		return text.replace('|', '\\|');
	}

}
