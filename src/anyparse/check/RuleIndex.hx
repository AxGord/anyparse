package anyparse.check;

import anyparse.check.Check.DefaultOff;
import anyparse.check.Check.VersionGated;

using StringTools;

/**
 * The rule index by category as markdown — what `apq lint --list-rules --format markdown` prints and
 * `docs/lint-rules.md` holds, a suite test keeping the two equal so a rule cannot ship without its line.
 */
@:nullSafety(Strict)
final class RuleIndex {

	/** The index of `checks`: a table of the categories that hold any of them, then one section per category, rules by id. */
	public static function markdown(checks: Array<Check>): String {
		final out: StringBuf = new StringBuf();
		out.add('# Lint rules by category\n\n');
		out.add(
			'Generated by `apq lint --list-rules --format markdown` from the rule registry; a suite test fails when the two disagree, so '
			+ 'regenerate this file instead of editing it. '
		);
		out.add(
			'A rule\'s category is what an `apqlint.json` `"categories"` entry and `apq lint --category <id>` select it by ('
			+ '[cli-query-tool.md](cli-query-tool.md) § "`apq lint`").\n\n'
		);
		out.add('| category | rules | about |\n|---|---:|---|\n');
		final sections: Array<{ category: RuleCategory, rules: Array<Check> }> = [];
		for (category in RuleCategory.ALL) {
			final rules: Array<Check> = checks.filter(c -> c.category() == category);
			if (rules.length == 0) continue;
			rules.sort((a, b) -> Reflect.compare(a.id(), b.id()));
			sections.push({ category: category, rules: rules });
			out.add('| [`$category`](#$category) | ${rules.length} | ${category.description()} |\n');
		}
		for (section in sections) {
			out.add(
				'\n## `${section.category}`\n\n${section.category.description()}.\n\n| rule | default | description |\n|---|---|---|\n'
			);
			for (rule in section.rules) {
				final state: String = rule is DefaultOff ? 'off' : 'on';
				final requires: String = rule is VersionGated
					? ' (fix needs language ${(cast rule: VersionGated).minLanguageVersion()})'
					: '';
				out.add('| `${rule.id()}` | $state | ${cell(rule.description())}$requires |\n');
			}
		}
		return out.toString();
	}

	/** `text` safe inside a markdown table cell: a pipe would end the cell. */
	private static inline function cell(text: String): String {
		return text.replace('|', '\\|');
	}

}
