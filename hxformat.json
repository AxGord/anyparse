{
	"indentation": {
		"character": "tab",
		"tabWidth": 4,
		"trailingWhitespace": false,
		"alignInlineSwitchCaseBody": true
	},
	"comments": {
		"blockCommentBodyIndent": "verbatim"
	},
	"emptyLines": {
		"maxAnywhereInFile": 2,
		"afterLeftCurly": "keep",
		"beforeRightCurly": "keep",
		"beforeDocCommentEmptyLines": "one",
		"classEmptyLines": {
			"beginType": 1,
			"endType": 1
		},
		"abstractEmptyLines": {
			"beginType": 1,
			"endType": 1
		},
		"interfaceEmptyLines": {
			"beginType": 1,
			"endType": 1
		},
		"externClassEmptyLines": {
			"beginType": 1,
			"endType": 1
		},
		"macroClassEmptyLines": {
			"beginType": 0,
			"endType": 0
		},
		"enumEmptyLines": {
			"betweenFields": 0,
			"existingBetweenFields": "remove",
			"beginType": 0,
			"endType": 0,
			"beginTypeIfDocComments": 1,
			"endTypeIfDocComments": 1,
			"afterFieldsWithDocComments": "none"
		},
		"typedefEmptyLines": {
			"betweenFields": 0,
			"existingBetweenFields": "remove",
			"beginType": 0,
			"endType": 0,
			"beginTypeIfDocComments": 1,
			"endTypeIfDocComments": 1,
			"afterFieldsWithDocComments": "none"
		},
		"enumAbstractEmptyLines": {
			"betweenVars": 0,
			"existingBetweenFields": "remove",
			"beginType": 0,
			"endType": 0,
			"beginTypeIfDocComments": 1,
			"endTypeIfDocComments": 1,
			"afterFieldsWithDocComments": "none"
		}
	},
	"wrapping": {
		"maxLineLength": 140,
		"functionSignature": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "totalItemLength <= n", "value": 100}, {"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				},
				{
					"conditions": [{"cond": "itemCount <= n", "value": 1}],
					"type": "noWrap"
				}
			]
		},
		"methodChain": {
			"defaultWrap": "noWrap",
			"itemsAfterCloseParenOnly": true,
			"rules": [
				{"conditions": [{"cond": "lineLength >= n", "value": 160}], "type": "onePerLine"},
				{"conditions": [{"cond": "itemCount <= n", "value": 3}, {"cond": "exceedsMaxLineLength", "value": 0}], "type": "noWrap"},
				{"conditions": [{"cond": "totalItemLength <= n", "value": 80}, {"cond": "exceedsMaxLineLength", "value": 0}], "type": "noWrap"},
				{"conditions": [{"cond": "anyItemLength >= n", "value": 30}, {"cond": "itemCount >= n", "value": 4}], "type": "onePerLine"},
				{"conditions": [{"cond": "itemCount >= n", "value": 7}], "type": "onePerLine"},
				{"conditions": [{"cond": "exceedsMaxLineLength", "value": 1}], "type": "onePerLine"}
			]
		},
		"callParameter": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				},
				{
					"conditions": [{"cond": "itemCount <= n", "value": 1}, {"cond": "totalItemLength <= n", "value": 100}],
					"type": "noWrap"
				}
			]
		},
		"expressionWrapping": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		},
		"conditionWrapping": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		}
	},
	"whitespace": {
		"addLineCommentSpace": true,
		"colonPolicy": "after",
		"typeHintColonPolicy": "after",
		"typeCheckColonPolicy": "after",
		"functionTypeHaxe3Policy": "around",
		"functionTypeHaxe4Policy": "around",
		"arrowFunctionsPolicy": "around",
		"ifPolicy": "around",
		"forPolicy": "around",
		"whilePolicy": "around",
		"switchPolicy": "around",
		"binopPolicy": "around",
		"intervalPolicy": "around",
		"bracesConfig": {
			"objectLiteralBraces": {
				"openingPolicy": "after",
				"closingPolicy": "before"
			},
			"anonTypeBraces": {
				"openingPolicy": "after",
				"closingPolicy": "before"
			},
			"singleStatementBraces": "symmetric"
		},
		"parenConfig": {
			"callParens": {
				"openingPolicy": "none",
				"closingPolicy": "none"
			},
			"funcParamParens": {
				"openingPolicy": "none",
				"closingPolicy": "none"
			},
			"conditionParens": {
				"openingPolicy": "before",
				"closingPolicy": "after"
			},
			"anonFuncParamParens": {
				"openingPolicy": "none",
				"closingPolicy": "none"
			}
		}
	},
	"lineEnds": {
		"emptyCurly": "noBreak"
	},
	"sameLine": {
		"ifBody": "fitLine",
		"forBody": "fitLine",
		"whileBody": "fitLine",
		"functionBody": "fitLine",
		"returnBody": "fitLine",
		"returnBodySingleLine": "fitLine",
		"expressionIf": "next",
		"comprehensionFor": "keep"
	}
}
