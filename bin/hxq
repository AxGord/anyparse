#!/usr/bin/env sh
# `hxq` — the Haxe preset of `apq`: `hxq <cmd> <args>` is `apq <cmd> --lang-default haxe <args>`:
# Haxe unless a file argument's extension names another registered grammar (a `.json` is read as JSON).
# Everything else — which engine runs (HXQ_BIN, a worktree's own build), the stale-engine
# rebuild, the code cache, node flags — is `bin/apq`'s, in that one place.
#
# Install (optional, for a global `hxq`): symlink this script into a PATH dir, e.g.
# `ln -s "$PWD/bin/hxq" ~/.local/bin/hxq`. It resolves its own real path through
# symlinks (POSIX `readlink`, no `-f`), so it still finds `apq` beside it.

set -e

src="$0"
while [ -h "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in
        /*) ;;
        *) src="$dir/$src" ;;
    esac
done
here=$(cd -P "$(dirname "$src")" && pwd)

# With no args `apq` prints its usage; otherwise `--lang-default haxe` goes right after the
# subcommand, where every command's own parser reads it.
if [ "$#" -gt 0 ]; then
    cmd="$1"
    shift
    set -- "$cmd" --lang-default haxe "$@"
fi
exec sh "$here/apq" "$@"
