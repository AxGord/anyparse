#!/usr/bin/env sh
# `hxq` — Haxe-preset alias for `apq`. Prepends `--lang haxe` to the
# ast/search/… subcommand's options.
#
# Engine dispatch: runs the JS build `bin/apq.js` via node. That is the
# only engine — the CLI reaches for `js.node` to spawn processes, and the
# neko target it once had died at module load before running a query, so
# it was dropped rather than kept as a build nobody could use.
#
# Build: `haxe bin/apq-js.hxml`.
#
# Install (optional, for a global `hxq`): symlink this script into a
# PATH dir, e.g. `ln -s "$PWD/bin/hxq" ~/.local/bin/hxq`. The script
# resolves its own real path through symlinks, so it still finds
# `apq.js` in the repo's bin/ regardless of the symlink location.
#
# Usage: hxq <subcommand> [options] <file>

set -e

# HXQ_BIN — explicit engine override, for parallel workers. Checked
# FIRST, before any path resolution: it depends on none of it, so an
# override skips the symlink walk and the `git rev-parse` probe below
# entirely, and works even where the shared bin/ holds no build at all
# (a fresh clone, or a worktree whose bin/ is empty).
#
# Several agents working the same repo at once all rebuild and run the
# ONE shared bin/apq.js: each build truncates the artifact the others are
# executing, so in practice only one agent can work at a time. With
# HXQ_BIN each agent builds a private engine into its own workdir
# (`tools/worker-build.sh <workdir>`) and drives every hxq subcommand —
# probes AND mutation ops — through it, so nobody rebuilds or races over
# the shared binary.
#
# The caller owns its private build, so the stale check below is skipped
# (HXQ_QUIET=1): the worker rebuilds when it decides to, and a private
# engine is a deliberate snapshot. The trade-off is that the snapshot
# goes stale the moment another agent lands a src/ change — rebuild
# before trusting a probe.
if [ -n "${HXQ_BIN:-}" ]; then
    if [ ! -f "$HXQ_BIN" ]; then
        echo "hxq: HXQ_BIN=$HXQ_BIN not found" >&2
        exit 1
    fi
    binary="$HXQ_BIN"
    HXQ_QUIET=1
else
    # Resolve this script's real path, following symlinks (POSIX
    # `readlink`, no `-f` — portable BSD/macOS + Linux). Without this,
    # invoking via a symlink would make `here` the symlink's dir, not the
    # repo bin/.
    src="$0"
    while [ -h "$src" ]; do
        dir=$(cd -P "$(dirname "$src")" && pwd)
        src=$(readlink "$src")
        case "$src" in
            /*) ;;
            *) src="$dir/$src" ;;
        esac
    done
    here=$(cd -P "$(dirname "$src")" && pwd)

    # Worktree awareness: when invoked from inside a git worktree (or
    # clone) whose own bin/ holds a built engine, prefer THAT engine +
    # its src/ over the symlink-resolved one above. Without this, `hxq`
    # run from a campaign worktree queries the MAIN tree's apq.js and
    # stale-checks the MAIN src/ — silently testing the wrong parser (the
    # worktree's grammar edits are invisible). Falls back to the
    # symlink-resolved `here` when CWD is outside a git tree (e.g.
    # reading a reference library), when the worktree's engine isn't
    # built yet, or when CWD is the main tree (then $wt_top/bin == $here,
    # no change). `|| true` keeps `set -e` happy when git is absent or
    # CWD is not a repo.
    wt_top=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$wt_top" ] && [ "$wt_top/bin" != "$here" ] && [ -f "$wt_top/bin/apq.js" ]; then
        here="$wt_top/bin"
    fi

    js="$here/apq.js"

    if [ ! -f "$js" ]; then
        echo "hxq: $js not found — run \`haxe bin/apq-js.hxml\`" >&2
        exit 1
    fi
    binary="$js"
fi

# Stale-build handling: if any .hx under src/ is newer than the selected
# binary, the user is invoking an outdated artifact. `find -newer …
# -quit` short-circuits at the first hit (sub-50ms even on cold cache)
# and stays silent when the repo layout doesn't match (e.g. shim copied
# outside the source tree).
#
# UX (default = auto-rebuild):
#   HXQ_QUIET=1         — skip the stale check entirely (no rebuild,
#                         no warning). Takes precedence over the other
#                         envs. Use when the harness is doing its own
#                         build management.
#   HXQ_AUTO_REBUILD=0  — opt OUT of auto-rebuild and fall back to the
#                         legacy warn-once-per-mtime mode. Useful when
#                         interactive feedback on the build itself is
#                         desired (`haxe bin/apq-js.hxml` separately).
#   Otherwise: auto-rebuild runs the appropriate `haxe bin/<hxml>` and
#   aborts on build failure. Stale results are silent regressions —
#   defaulting to auto-rebuild keeps query output truthful without
#   manual rebuilds between grammar edits.
# `here` is set only on the shared-engine path above; an HXQ_BIN override
# sets HXQ_QUIET=1, so this whole block is skipped in that case.
src_root="${here:-}/../src"
if [ "${HXQ_QUIET:-}" != "1" ] && [ -d "$src_root" ]; then
    stale=$(find "$src_root" -name '*.hx' -newer "$binary" -print -quit 2>/dev/null || true)
    if [ -n "$stale" ]; then
        bin_name="bin/apq.js"
        hxml_path="$here/apq-js.hxml"
        hxml_name="bin/apq-js.hxml"
        if [ "${HXQ_AUTO_REBUILD:-1}" != "0" ]; then
            # Rebuild in-process (DEFAULT). On failure print the build's
            # stderr and bail — running a stale binary after a failed
            # rebuild would be misleading.
            echo "hxq: src/ newer than $bin_name; auto-rebuilding ($hxml_name)..." >&2
            echo "hxq: (~11s. A CHAIN of edits pays it PER OP, because a mutation op writes src/ itself." >&2
            echo "hxq:  For a multi-step edit run the intermediate ops with HXQ_AUTO_REBUILD=0 and rebuild" >&2
            echo "hxq:  once at the end. Never HXQ_QUIET=1 for that — it disables the check entirely and a" >&2
            echo "hxq:  later verification probe then runs a stale binary and lies.)" >&2
            if ! (cd "$here/.." && haxe "$hxml_path") >&2; then
                echo "hxq: auto-rebuild failed; aborting (set HXQ_AUTO_REBUILD=0 for warn-only mode, or HXQ_QUIET=1 to skip the check)" >&2
                exit 1
            fi
        else
            # Legacy warn-only mode (opt-in via HXQ_AUTO_REBUILD=0).
            # mtime-keyed throttle. Portable mtime: `stat` differs
            # across BSD/macOS (`-f %m`) and GNU (`-c %Y`).
            if mtime=$(stat -f %m "$binary" 2>/dev/null); then :
            elif mtime=$(stat -c %Y "$binary" 2>/dev/null); then :
            else mtime="unknown"
            fi
            cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hxq"
            marker="$cache_dir/warned"
            last=""
            [ -r "$marker" ] && last=$(cat "$marker" 2>/dev/null || true)
            if [ "$last" != "$mtime" ]; then
                echo "hxq: warning: src/ has .hx files newer than $bin_name — run \`haxe $hxml_name\` to rebuild (first stale: $stale)" >&2
                echo "hxq: (silenced for this binary mtime; clear HXQ_AUTO_REBUILD to auto-rebuild, set HXQ_QUIET=1 to disable check)" >&2
                mkdir -p "$cache_dir" 2>/dev/null || true
                printf '%s' "$mtime" > "$marker" 2>/dev/null || true
            fi
        fi
    fi
fi

# With no user args, just run the binary (prints usage); otherwise inject
# `--lang haxe` after the subcommand so `hxq <cmd> [opts] <file>` targets
# the Haxe grammar.
if [ "$#" -eq 0 ]; then
    exec node "$binary"
fi

cmd="$1"
shift
exec node "$binary" "$cmd" --lang haxe "$@"
