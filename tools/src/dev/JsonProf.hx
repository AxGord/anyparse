package dev;

import anyparse.check.oracle.ReachBuildsRecord;
import anyparse.check.oracle.ReachBuildsRecordParser;
import anyparse.check.oracle.ReachBuildsRecordWriter;
import anyparse.grammar.json.JsonFormat;
import anyparse.query.FactNodeRecords;
import anyparse.query.StoredTree;
import anyparse.query.StoredTreeParser;
import anyparse.query.StoredTreeWriter;
import anyparse.query.format.json.FactFileRecordParser;
import anyparse.query.format.json.FactNodeRecord;
import anyparse.query.format.json.FactNodeRecordParser;
import anyparse.query.format.json.FactNodeRecordText;
import anyparse.query.format.json.FactSourceRecordParser;
import anyparse.query.format.json.FactTargetRecordParser;
import anyparse.query.format.json.FactTypeRecordParser;
import anyparse.runtime.Parser;
import anyparse.runtime.StringInput;
import haxe.DynamicAccess;

using Lambda;
using StringTools;

/**
 * The typed JSON way against `haxe.Json` over real documents (`docs/formats.md` § "The native door"): the `json-*` modes of
 * `dev parse-prof`, and a `main` of its own so a native arm builds without the rest of the harness (`tools/bench-json-cpp.hxml`).
 * `<sample>` is a facts file for `facts`, a reach-builds record for `reach`, and anything for the others. Each mode prints the
 * summary line `dev bench-ab` reads; `-std` is the bar, `-typed` the shipped call, `-bytes` the generated byte-level parser.
 */
@:nullSafety(Strict)
final class JsonProf {

	public static inline final USAGE: String =
		'json-facts-<std|typed|bytes|site> | json-identity-<std|typed> | json-reach-<parse|write>-<std|typed|bytes> | json-reach-parse-hand | json-stored-<parse|write>-<std|typed> | json-escape-<std|typed>';

	private static inline final MS_PER_SECOND: Float = 1000.0;

	/** The prefix of a facts file's node line. */
	private static inline final NODE_LINE: String = '{"k":"node"';

	/** Hundredths of a millisecond: the precision a reading is printed in. */
	private static inline final HUNDREDTHS: Float = 100.0;

	/** How many distinct integers a stored tree's runs cycle through. */
	private static inline final STORED_SPREAD: Int = 1000;

	/** The strings `json-escape-*` quotes in one rep. */
	private static inline final ESCAPES: Int = 200000;

	/** The node of a stored tree `json-stored-*` holds: one run of integers per node, as `ParseDiskCache` writes it. */
	private static inline final STORED_NODES: Int = 2000000;

	public static function main(): Void {
		final args: Array<String> = Sys.args();
		run(args[0], args.length > 1 ? args[1] : '', args.length > 2 ? (Std.parseInt(args[2]) ?? 1) : 1);
	}

	/** Runs `mode` over `sample` `reps` times and prints its line; everything but the work itself stays off the clock. */
	public static function run(mode: String, sample: String, reps: Int): Int {
		final work: () -> Int = workOf(mode, sample);
		final start: Float = now();
		var sink: Int = 0;
		for (_ in 0...reps) sink += work();
		final seconds: Float = now() - start;
		final perRep: Float = Math.round(seconds * MS_PER_SECOND / reps * HUNDREDTHS) / HUNDREDTHS;
		Sys.println('MODE=$mode reps=$reps msPerRep=$perRep sink=$sink');
		return 0;
	}

	private static function workOf(mode: String, sample: String): () -> Int {
		return switch mode {
			case 'json-facts-std': factsStd.bind(lines(sample));
			case 'json-facts-typed': factsTyped.bind(FactNodeRecordParser.parse, lines(sample));
			case 'json-facts-bytes': factsBytes.bind(lines(sample));
			case 'json-facts-site': factsTyped.bind(FactNodeRecords.parseLine, lines(sample));
			case 'json-identity-std': identityStd.bind(nodes(sample));
			case 'json-identity-typed': identityTyped.bind(nodes(sample));
			case 'json-reach-parse-std': reachParseStd.bind(sys.io.File.getContent(sample));
			case 'json-reach-parse-typed': reachParseTyped.bind(sys.io.File.getContent(sample));
			case 'json-reach-parse-bytes': reachParseBytes.bind(sys.io.File.getContent(sample));
			case 'json-reach-parse-hand': reachParseHand.bind(sys.io.File.getContent(sample));
			case 'json-reach-write-std': reachWriteStd.bind(ReachBuildsRecordParser.parse(sys.io.File.getContent(sample)));
			case 'json-reach-write-typed': reachWriteTyped.bind(ReachBuildsRecordParser.parse(sys.io.File.getContent(sample)));
			case 'json-stored-parse-std':
				storedParseStd.bind(StoredTreeWriter.write(storedSample(), JsonFormat.instance.compactWriteOptions));
			case 'json-stored-parse-typed':
				storedParseTyped.bind(StoredTreeWriter.write(storedSample(), JsonFormat.instance.compactWriteOptions));
			case 'json-stored-write-std': storedWriteStd.bind(storedSample());
			case 'json-stored-write-typed': storedWriteTyped.bind(storedSample());
			case 'json-escape-std': escapeStd;
			case 'json-escape-typed': escapeTyped;
			case _: throw new haxe.Exception('unknown mode $mode: $USAGE');
		};
	}

	private static function lines(sample: String): Array<String> {
		return sys.io.File.getContent(sample).split('\n').filter(line -> line != '');
	}

	private static function nodes(sample: String): Array<FactNodeRecord> {
		return [
			for (line in lines(sample)) if (line.startsWith(NODE_LINE)) FactNodeRecordParser.parse(line)
		];
	}

	private static function factsStd(lines: Array<String>): Int {
		return lines.count(line -> haxe.Json.parse(line) != null); // noqa: avoid-haxe-json
	}

	/** Every line of a facts file read typed, its node lines through `node`. */
	private static function factsTyped(node: (String) -> FactNodeRecord, lines: Array<String>): Int {
		var seen: Int = 0;
		for (line in lines) {
			if (line.startsWith(NODE_LINE)) {
				if (node(line).id != '') seen++;
			} else if (line.startsWith('{"k":"type"')) {
				if (FactTypeRecordParser.parse(line).id != '') seen++;
			} else if (line.startsWith('{"k":"src"')) {
				if (FactSourceRecordParser.parse(line).path != '') seen++;
			} else if (line.startsWith('{"k":"target"')) {
				if (FactTargetRecordParser.parse(line).n != '') seen++;
			} else if (line.startsWith('{"k":"file"') && FactFileRecordParser.parse(line).path != '') {
				seen++;
			}
		}
		return seen;
	}

	private static function factsBytes(lines: Array<String>): Int {
		var seen: Int = 0;
		for (line in lines) if (line.startsWith(NODE_LINE)) {
			if (FactNodeRecordParser.parseWith(new Parser(new StringInput(line))).id != '') seen++;
		} else if (line.startsWith('{"k":"type"') && FactTypeRecordParser.parseWith(new Parser(new StringInput(line))).id != '') {
			seen++;
		}
		return seen;
	}

	private static function identityStd(nodes: Array<FactNodeRecord>): Int {
		var bytes: Int = 0;
		for (node in nodes) {
			for (c in node.calls ?? []) bytes += haxe.Json.stringify(c).length; // noqa: avoid-haxe-json
			for (f in node.fields ?? []) bytes += haxe.Json.stringify(f).length; // noqa: avoid-haxe-json
			for (v in node.vars ?? []) bytes += haxe.Json.stringify(v).length; // noqa: avoid-haxe-json
		}
		return bytes;
	}

	private static function identityTyped(nodes: Array<FactNodeRecord>): Int {
		var bytes: Int = 0;
		for (node in nodes) {
			for (c in node.calls ?? []) bytes += FactNodeRecordText.compactFactCallRecord(c).length;
			for (f in node.fields ?? []) bytes += FactNodeRecordText.compactFactFieldRecord(f).length;
			for (v in node.vars ?? []) bytes += FactNodeRecordText.compactFactVarRecord(v).length;
		}
		return bytes;
	}

	private static function reachParseStd(text: String): Int {
		return haxe.Json.parse(text) == null ? 0 : 1; // noqa: avoid-haxe-json
	}

	private static function reachParseTyped(text: String): Int {
		return ReachBuildsRecordParser.parse(text).configurations.length;
	}

	private static function reachParseBytes(text: String): Int {
		return ReachBuildsRecordParser.parseWith(new Parser(new StringInput(text))).configurations.length;
	}

	private static function reachWriteStd(record: ReachBuildsRecord): Int {
		return flat(haxe.Json.stringify(record)); // noqa: avoid-haxe-json
	}

	private static function reachWriteTyped(record: ReachBuildsRecord): Int {
		return flat(ReachBuildsRecordWriter.write(record, JsonFormat.instance.compactWriteOptions));
	}

	private static function storedSample(): StoredTree {
		return { strings: ['Node', 'name'], ints: [for (i in 0...STORED_NODES) i % STORED_SPREAD] };
	}

	private static function storedParseStd(text: String): Int {
		final stored: StoredTree = haxe.Json.parse(text); // noqa: avoid-haxe-json
		return stored.ints.length;
	}

	private static function storedParseTyped(text: String): Int {
		return StoredTreeParser.parse(text).ints.length;
	}

	private static function storedWriteStd(stored: StoredTree): Int {
		return flat(haxe.Json.stringify(stored)); // noqa: avoid-haxe-json
	}

	private static function storedWriteTyped(stored: StoredTree): Int {
		return flat(StoredTreeWriter.write(stored, JsonFormat.instance.compactWriteOptions));
	}

	private static function escapeStd(): Int {
		var bytes: Int = 0;
		for (i in 0...ESCAPES) bytes += haxe.Json.stringify('path/to/a/module$i.hx').length; // noqa: avoid-haxe-json
		return bytes;
	}

	private static function escapeTyped(): Int {
		var bytes: Int = 0;
		for (i in 0...ESCAPES) bytes += JsonFormat.instance.quote('path/to/a/module$i.hx').length;
		return bytes;
	}

	/** `text`'s length, read so that a text still in pieces costs what writing it to a file will. */
	private static function flat(text: String): Int {
		return text.charCodeAt(text.length - 1) == 0 ? 0 : text.length;
	}

	private static function now(): Float {
		return #if js js.Syntax.code('performance.now() / 1000') #else haxe.Timer.stamp() #end;
	}

	/**
	 * The reach-builds record as `ReachBuildsCache` read it before the door: `haxe.Json` and a hand check of every value it
	 * reads, so the typed arm is held against what the site paid, not against the engine's parse alone.
	 */
	private static function reachParseHand(text: String): Int {
		final record: Null<DynamicAccess<Any>> = handObject(haxe.Json.parse(text)); // noqa: avoid-haxe-json
		if (record == null || !(record['format'] is String) || !(record['key'] is String)) return 0;
		final stats: Null<Array<Any>> = handList(record['stats']);
		if (stats == null || !stats.foreach(entry -> handTexts(entry) != null)) return 0;
		final configurations: Array<Any> = handList(record['configurations']) ?? [];
		if (!configurations.foreach(handConfiguration)) return 0;
		for (e in handList(record['library']) ?? []) {
			final entry: Null<DynamicAccess<Any>> = handObject(e);
			if (entry == null || !(entry['file'] is String) || !(entry['hash'] is String)) return 0;
		}
		return configurations.length;
	}

	private static function handList(value: Null<Any>): Null<Array<Any>> {
		return value is Array ? cast value : null;
	}

	private static function handTexts(value: Null<Any>): Null<Array<String>> {
		final items: Null<Array<Any>> = handList(value);
		return items != null && items.foreach(item -> item is String) ? cast items : null;
	}

	private static function handObject(value: Null<Any>): Null<DynamicAccess<Any>> {
		return value != null && Reflect.isObject(value) && !(value is String) && !(value is Array) ? cast value : null;
	}

	/** Whether one configuration of a reach-builds record holds what `ReachBuildsCache` read, checked by hand. */
	private static function handConfiguration(c: Null<Any>): Bool {
		final configuration: Null<DynamicAccess<Any>> = handObject(c);
		if (configuration == null || !(configuration['name'] is String)) return false;
		for (key in ['defined', 'everDefined', 'compiled']) if (handTexts(configuration[key]) == null) return false;
		return (configuration['parsed'] == null || handTexts(configuration['parsed']) != null)
			&& (handList(configuration['values']) ?? []).foreach(pair -> handTexts(pair) != null)
			&& (handList(configuration['types']) ?? []).foreach(t -> {
				final type: Null<DynamicAccess<Any>> = handObject(t);
				type != null && type['name'] is String && type['file'] is String;
			});
	}

}
