package devkit;

import devkit.Cmd.cmd;
import haxe.Exception;
import haxe.crypto.Sha256;
import haxe.io.Path;
import js.node.Fs.Fs;
import js.node.fs.Stats;
import sys.FileSystem;
import sys.io.File;

using StringTools;

/**
 * The `haxe` shim that puts `testkit.FixtureCompileCache` in front of the probe compiles of a suite run, and the upkeep
 * of the store it replays from — the Haxe twin of `tools/fixture-cache.sh`. The store outlives a run; why replaying from
 * it stays sound is the class doc of `FixtureCompileCache` (the key is every input by content), and what a kept store
 * adds is a compiler install that may change between runs, so the shim's stamp names the binary by its resolved path,
 * `-version`, size and mtime.
 */
@:nullSafety(Strict)
final class FixtureCache {

	/** Days an entry no run has hit is kept, unless `FC_MAX_AGE_DAYS` says otherwise. */
	public static inline final MAX_AGE_DAYS: Int = 7;

	/** Seconds in a day: `find -mtime` counts whole days of age. */
	private static inline final SECONDS_PER_DAY: Float = 86400;

	private static inline final MS_PER_SECOND: Float = 1000;

	/** The hex digits of the replay program's source digest its file name carries. */
	private static inline final DIGEST_LENGTH: Int = 16;

	/** What a probe compile's command line holds, as the shim's `case` pattern matches it. */
	private static inline final PROBE_PATTERN: String = '*anyparse.check.facts.TypedFactsMacro.run\\(*|*AnyparseReachDefinesProbe.*';

	/** The `haxe` on `PATH`, every symlink resolved to the binary it names; null when there is none. */
	public static function realHaxe(): Null<String> {
		for (dir in (Sys.getEnv('PATH') ?? '').split(':')) if (dir != '') {
			final candidate: String = Path.join([dir, 'haxe']);
			if (isExecutable(candidate)) return FileSystem.fullPath(candidate);
		}
		return null;
	}

	/**
	 * Build the replay program (once per content of `FixtureCompileCache.hx`, kept in `entries`) and write the shim
	 * `<bindir>/haxe` that routes every probe compile through it. Answers null, or why not — the caller then runs every
	 * compile for real.
	 */
	public static function shim(repo: String, entries: String, bindir: String, ?tally: String): Null<String> {
		final real: Null<String> = realHaxe();
		if (real == null) return 'fixture-cache: no haxe on PATH';
		FileSystem.createDirectory(entries);
		FileSystem.createDirectory(bindir);
		final sum: String = Sha256.make(File.getBytes('$repo/test/testkit/FixtureCompileCache.hx')).toHex().substr(0, DIGEST_LENGTH);
		final replay: String = '$entries/fixture-cache-$sum.js';
		if (!FileSystem.exists(replay)) {
			final tmp: String = '$replay.${js.Node.process.pid}.tmp';
			final build: Result = cmd('haxe tools/fixture-cache-common.hxml -js $tmp').at(repo).run();
			File.saveContent('$entries/build-$sum.log', build.out + build.err);
			if (!build.ok) {
				if (FileSystem.exists(tmp)) FileSystem.deleteFile(tmp);
				return 'fixture-cache: the replay program could not be built ($entries/build-$sum.log)';
			}
			FileSystem.rename(tmp, replay);
		}
		// in use: a concurrent run's prune must not take it away mid-run
		touch(replay);
		final version: Result = Command.of([real, '-version']).run();
		final stat: Stats = Fs.statSync(real);
		final stamp: String = '$real ${(version.out + version.err).rtrim()} ${stat.size} ${Std.int(stat.mtime.getTime() / MS_PER_SECOND)}';
		final env: String = [
			'APQ_FIXTURE_CACHE_HAXE=${quoted(real)}',
			'APQ_FIXTURE_CACHE_STAMP=${quoted(stamp)}',
			'APQ_FIXTURE_CACHE_DIR=${quoted(entries)}',
			'APQ_FIXTURE_CACHE_TALLY=${quoted(tally ?? '$entries/tally')}'
		].join(' ');
		// paths are baked in rather than exported: a test that spawns the compiler under an environment of its own must
		// still reach the cache
		final file: String = '$bindir/haxe';
		File.saveContent(file, [
			'#!/bin/bash',
			'# Generated by devkit.FixtureCache: probe compiles go through the fixture cache.',
			'case "$$*" in',
			'    $PROBE_PATTERN)',
			'        $env exec node ${quoted(replay)} "$$@" ;;',
			'esac',
			'exec ${quoted(real)} "$$@"',
			''
		].join('\n'));
		Fs.chmodSync(file, '755');
		return null;
	}

	/** Drop the entries of `entries` no run has hit for more than `days` whole days, and replay programs that old. */
	public static function prune(entries: String, days: Int): Void {
		if (!FileSystem.exists(entries) || !FileSystem.isDirectory(entries)) return;
		final now: Float = Sys.time();
		for (name in FileSystem.readDirectory(entries)) if (isPrunable(name)) {
			final path: String = Path.join([entries, name]);
			// gone since the listing is a concurrent run's prune having got there first
			final stat: Null<Stats> = try Fs.lstatSync(path) catch (exception: Exception) null;
			if (stat != null && stat.isFile() && Math.floor((now - stat.mtime.getTime() / MS_PER_SECOND) / SECONDS_PER_DAY) > days)
				js.Syntax.code("require('fs').rmSync({0}, { force: true })", path);
		}
	}

	/** `N hit, M miss, K pass` — what the compiles that wrote the tally file `file` did; null when there is none. */
	public static function tally(file: String): Null<String> {
		if (!FileSystem.exists(file)) return null;
		final lines: Array<String> = File.getContent(file).split('\n');
		if (lines[lines.length - 1] == '') lines.pop();
		if (lines.length == 0) return '';
		lines.sort(Reflect.compare);
		final counts: Array<String> = [];
		var i: Int = 0;
		while (i < lines.length) {
			var j: Int = i;
			while (j < lines.length && lines[j] == lines[i]) j++;
			counts.push('${j - i} ${lines[i].trim().split(' ')[0]}');
			i = j;
		}
		return counts.join(', ');
	}

	/** The age limit the environment gives (`FC_MAX_AGE_DAYS`). */
	public static function maxAgeDays(): Int {
		return Std.parseInt(Sys.getEnv('FC_MAX_AGE_DAYS') ?? '') ?? MAX_AGE_DAYS;
	}

	private static function isPrunable(name: String): Bool {
		return name.endsWith('.json.gz') || (name.startsWith('fixture-cache-') && name.endsWith('.js'))
			|| (name.startsWith('build-') && name.endsWith('.log')) || name.endsWith('.tmp');
	}

	private static function isExecutable(path: String): Bool {
		return try {
			Fs.accessSync(path, Fs.X_OK);
			!FileSystem.isDirectory(path);
		} catch (exception: Exception) false;
	}

	private static function touch(path: String): Void {
		final now: Date = Date.now();
		Fs.utimesSync(path, now, now);
	}

	/** `text` as one bash word. */
	private static function quoted(text: String): String {
		return text != '' && ~/^[A-Za-z0-9_@%+=:,.\/-]+$/.match(text) ? text : "'" + text.split("'").join("'\\''") + "'";
	}

}
