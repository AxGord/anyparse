	"files": {
		"src/demo/Greeter.hx": "package demo;\n\nimport demo.Shape;\nimport haxe.ds.StringMap;\n\n/** Greets by name. */\nclass Greeter implements Named {\n\n\tpublic var name: String;\n\n\tprivate var count: Int = 0;\n\n\tpublic function new(name: String) {\n\t\tthis.name = name;\n\t}\n\n\tpublic function greet(other: String): String {\n\t\tcount++;\n\t\tfinal text: String = 'Hello, ' + other + ' from ' + name;\n\t\treturn text;\n\t}\n\n\tpublic function twice(other: String): String {\n\t\treturn greet(other) + greet(other);\n\t}\n\n\tpublic static function main(): Void {\n\t\t#if debug\n\t\ttrace('debug');\n\t\t#end\n\t\tfinal g: Greeter = new Greeter('a');\n\t\ttrace(g.twice('b'));\n\t}\n\n}\n",
		"src/demo/Named.hx": "package demo;\n\ninterface Named {\n\n\tvar name: String;\n\n}\n",
		"src/demo/Shape.hx": "package demo;\n\nenum Shape {\n\tCircle(r: Float);\n\tSquare(side: Float);\n}\n\nclass Area {\n\n\tpublic static function of(shape: Shape): Float {\n\t\treturn switch shape {\n\t\t\tcase Circle(r): Math.PI * r * r;\n\t\t\tcase Square(side): side * side;\n\t\t}\n\t}\n\n}\n",
