{
	"compilerOracle": "test-js.hxml",
	"compilerOracleServer": false,
	"resolutionRoots": [
		"src",
		"test"
	],
	"resolutionLibs": [
		"hxnodejs",
		"utest"
	],
	"ownedTypes": [
		{
			"types": [
				"anyparse.query.SymbolIndex.ImportInfo",
				"anyparse.query.SymbolIndex.ImportKind",
				"anyparse.query.SymbolIndex.AmbientImportGroup"
			],
			"owners": [
				"anyparse.query.TypeNameBinding",
				"anyparse.query.ImportBindings",
				"anyparse.query.TypeRefIndex",
				"anyparse.query.SymbolIndex",
				"anyparse.query.SymbolIndexBuilder",
				"anyparse.check.RedundantImport",
				"anyparse.check.UnusedImport",
				"anyparse.check.HoistCommonImport",
				"anyparse.query.MoveSymbol",
				"anyparse.query.DependencyCarry",
				"anyparse.query.GuardedImportCarry"
			],
			"why": "an import statement is read through the name-resolution layer (what a name means) or edited by the import tier; every other consumer asks TypeNameBinding / ImportBindings / TypeRefIndex instead of decoding the statement again"
		},
		{
			"types": [
				"anyparse.query.CompilerFacts"
			],
			"owners": [
				"anyparse.query.FactsView",
				"anyparse.check.TypedFactsWalk",
				"anyparse.check.FactsTypeOracle",
				"anyparse.check.FactsTypeText",
				"anyparse.check.FactsTypeTree",
				"anyparse.query.CallGraphFacts",
				"anyparse.query.FactsProvenance",
				"anyparse.query.FactsEscapes",
				"anyparse.query.FactsMethodValues",
				"anyparse.query.FactText",
				"anyparse.query.FactsNativeReach",
				"anyparse.query.FunctionValueTypes",
				"anyparse.query.CachingGrammarPlugin",
				"anyparse.query.SymbolIndexHost",
				"anyparse.query.cli.command.LintCommand",
				"anyparse.query.cli.command.LintFixVerify"
			],
			"why": "the compiler's facts are read through the facts layer (FactsView, TypedFactsWalk, FactsTypeOracle) and produced by the run host; a rule reading CompilerFacts directly grows a third facts reader"
		},
		{
			"types": [
				"anyparse.query.CallGraphTypes",
				"anyparse.query.CallGraphImports"
			],
			"owners": [
				"anyparse.query.CallGraph*"
			],
			"why": "the call graph's own type and import resolution; outside the graph, members resolve through MemberLookup / SubtypeGraph and names through TypeNameBinding"
		},
		{
			"members": [
				"anyparse.query.SymbolIndex.build",
				"anyparse.query.FieldWriteIndex.build",
				"anyparse.query.FieldWriteIndex.new"
			],
			"owners": [
				"anyparse.query.CachingGrammarPlugin",
				"anyparse.query.RefactorSupport"
			],
			"why": "the index host (CachingGrammarPlugin as SymbolIndexHost, reached through RefactorSupport.lazySymbolIndex / fieldWriteIndexOf) builds and memoises the indexes once per run; a consumer building its own picks its own scope and pays a rebuild"
		}
	],
	"rules": {
		"explicit-local-type": {
			"enabled": true
		},
		"anon-type-dup": {
			"enabled": true
		},
		"case-pattern-separator": {
			"enabled": true
		},
		"collapse-nested-switch": {
			"enabled": true
		},
		"comment-width": {
			"enabled": true
		},
		"cond-assign-merge": {
			"enabled": true
		},
		"dead-binder-counter-loop": {
			"enabled": true
		},
		"doc-length": {
			"enabled": true
		},
		"doc-measurement-claim": {
			"enabled": true
		},
		"field-init-in-constructor": {
			"enabled": true
		},
		"hoist-branch-string-affix": {
			"enabled": true
		},
		"hoist-embedded-assignment": {
			"enabled": true
		},
		"import-order": {
			"enabled": true
		},
		"join-override-chain": {
			"enabled": true
		},
		"join-string-append": {
			"enabled": true
		},
		"misplaced-type-doc": {
			"enabled": true
		},
		"no-underscore-prefix": {
			"enabled": true
		},
		"orphan-accessor": {
			"enabled": true
		},
		"oversized-type": {
			"grants": [
				"Renderer: the Doc layout engine is ONE algorithm — 47 of its 48 non-hub members land in a single `hxq clusters` component (98%), because every fit probe, push and flush reads the same render state. S11 measured the only real seam, a 22-member width layer, and cutting it leaves 2383 lines behind.",
				"WrapList: one wrapping decision table, 80 of 94 non-hub members in one component (85%). The members are arms of a single policy keyed by construct, not collaborating objects; splitting them by call edges would move the arms and leave the dispatch.",
				"NullFlow: one MaybeNull lattice plus its transfer functions — 50 of 52 non-hub members in one component (96%). A flow-sensitive dataflow analysis has no seam that is not the lattice itself."
			]
		},
		"prefer-doc-comment": {
			"enabled": true
		},
		"prefer-exists": {
			"enabled": true
		},
		"prefer-for-in": {
			"enabled": true
		},
		"prefer-foreach": {
			"enabled": true
		},
		"prefer-keyvalue-loop": {
			"enabled": true
		},
		"prefer-line-comment": {
			"enabled": true
		},
		"prefer-lpad": {
			"enabled": true
		},
		"prefer-typed-throw": {
			"enabled": true
		},
		"prefer-value-loop": {
			"enabled": true
		},
		"redundant-ascription": {
			"enabled": true
		},
		"redundant-cast-type": {
			"enabled": true
		},
		"redundant-isvar": {
			"enabled": true
		},
		"redundant-lambda-wrapper": {
			"enabled": true
		},
		"redundant-map-exists": {
			"enabled": true
		},
		"redundant-property-access": {
			"enabled": true
		},
		"redundant-replace-loop": {
			"enabled": true
		},
		"redundant-tostring": {
			"enabled": true
		},
		"redundant-trailing-comma": {
			"enabled": true
		},
		"return-reassign-ternary": {
			"enabled": true
		},
		"shorten-type-ref": {
			"enabled": true
		},
		"static-constant": {
			"enabled": true
		},
		"try-catch-null-guard": {
			"enabled": true
		},
		"unused-loop-binder": {
			"enabled": true
		},
		"unused-public-member": {
			"enabled": true
		},
		"while-true-condition": {
			"enabled": true
		}
	}
}
