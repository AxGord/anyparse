{
    "rules": {
        "magic-number": false,
        "string-literal-dup": false,
        "doc-coverage": false,
        "oversized-type": {
            "maxMembers": 100,
            "grants": []
        },
        "duplicate-code": false,
        "prefer-typed-throw": false,
        "owned-types": false
    }
}
